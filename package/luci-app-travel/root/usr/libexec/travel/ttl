#!/bin/sh
# "Look like one device": every packet leaves with TTL 64, what a phone or
# laptop sends itself. Behind a router they would arrive with 63, which is
# how hotels and mobile carriers spot shared connections. Through a tethered
# phone it's 65, because the phone counts one more hop before the carrier
# sees it. firewall4 includes the result (firewall.travel_ttl) at the end of
# its mangle_postrouting chain. Costs one thing: traceroute from your devices
# no longer shows the path. Toggle with travel.main.hide_router.

. /usr/libexec/travel/lib.sh

F=/etc/travel/ttl.nft
new="$TRAVEL_RUN/ttl.nft.new"

if [ "$(tget hide_router 1)" = 1 ]; then
	phones="$(cat "$TRAVEL_RUN"/phone.* 2>/dev/null | sed 's/.*/"&"/' | tr '\n' ',' | sed 's/,$//')"
	{
		echo '# generated by /usr/libexec/travel/ttl'
		echo 'oifname != "br-lan" ip ttl set 64'
		echo 'oifname != "br-lan" ip6 hoplimit set 64'
		if [ -n "$phones" ]; then
			echo "oifname { $phones } ip ttl set 65"
			echo "oifname { $phones } ip6 hoplimit set 65"
		fi
	} >"$new"
else
	echo '# generated by /usr/libexec/travel/ttl: "look like one device" is off' >"$new"
fi

mkdir -p /etc/travel
if cmp -s "$new" "$F"; then
	rm -f "$new"
	exit 0
fi
mv "$new" "$F"
fw4 -q reload 2>/dev/null || /etc/init.d/firewall reload >/dev/null 2>&1
